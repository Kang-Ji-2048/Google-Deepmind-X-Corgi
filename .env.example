# Gemma configuration is reserved until its adapter is delivered.
# Recipe search is wired; replace the Google key below to enable it.
# See docs/gemma-integration.md for the Gemma collaborator's handoff.
# Server-only Gemma integration. Never rename these with a NEXT_PUBLIC_ prefix.
# Proposed HTTP adapter: full analysis endpoint, including the service route.
GEMMA_API_URL=https://gemma-service.example.com/analyze
GEMMA_API_KEY=replace-me
GEMMA_API_TIMEOUT_MS=45000
GEMMA_USE_MOCK=true

# `mealdb` is the zero-card development default. Set `google` only when the
# Gemini project has Search Grounding quota. TheMealDB documents key `1` for
# development and education; use a supporter key for a public production app.
RECIPE_SEARCH_PROVIDER=mealdb
MEALDB_API_KEY=1
# Explicit opt-in for a labelled development/educational demo on a hosted preview.
# Leave false for a public product release; configure a production supporter key.
MEALDB_ALLOW_DEMO_KEY=false

# Optional server-only Gemini API integration with Google Search grounding.
# Send the key only as x-goog-api-key.
RECIPE_SEARCH_API_URL=https://generativelanguage.googleapis.com/v1beta
RECIPE_SEARCH_API_KEY=replace-with-gemini-api-key
RECIPE_SEARCH_MODEL=gemini-3.6-flash
RECIPE_SEARCH_TIMEOUT_MS=10000
# Reserved for future explicit demos. Current /api/recipes ignores this flag
# and never substitutes fixtures for real Google search.
RECIPE_SEARCH_USE_MOCK=false

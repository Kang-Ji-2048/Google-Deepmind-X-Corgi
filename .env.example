# Reserved configuration for adapters that are not wired yet.
# These placeholders do not enable live analysis or recipe search.
# See docs/gemma-integration.md for the Gemma collaborator's handoff.
# Server-only Gemma integration. Never rename these with a NEXT_PUBLIC_ prefix.
# Proposed HTTP adapter: full analysis endpoint, including the service route.
GEMMA_API_URL=https://gemma-service.example.com/analyze
GEMMA_API_KEY=replace-me
GEMMA_API_TIMEOUT_MS=45000
GEMMA_USE_MOCK=true

# Server-only recipe search integration.
RECIPE_SEARCH_API_URL=https://recipe-search.example.com
RECIPE_SEARCH_API_KEY=replace-me
RECIPE_SEARCH_TIMEOUT_MS=10000
RECIPE_SEARCH_USE_MOCK=true

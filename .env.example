# Reserved configuration for adapters that are not wired yet.
# These placeholders do not enable live analysis or recipe search.
# See docs/gemma-integration.md for the Gemma collaborator's handoff.
# Server-only Gemma integration. Never rename these with a NEXT_PUBLIC_ prefix.
# Proposed HTTP adapter: full analysis endpoint, including the service route.
GEMMA_API_URL=https://gemma-service.example.com/analyze
GEMMA_API_KEY=replace-me
GEMMA_API_TIMEOUT_MS=45000
GEMMA_USE_MOCK=true

# Server-only Gemini API integration with Google Search grounding. The URL and
# model may be omitted to use adapter defaults; they remain explicit here so the
# deployment contract is visible. Send the key only as x-goog-api-key.
RECIPE_SEARCH_API_URL=https://generativelanguage.googleapis.com/v1beta
RECIPE_SEARCH_API_KEY=replace-with-gemini-api-key
RECIPE_SEARCH_MODEL=gemini-2.5-flash
RECIPE_SEARCH_TIMEOUT_MS=10000
# true selects deterministic fixtures only when the server route opts into mock mode.
# It is never an automatic fallback for a missing key or provider failure.
RECIPE_SEARCH_USE_MOCK=true
